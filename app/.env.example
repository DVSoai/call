# Copy file này thành .env rồi chỉnh URL trỏ tới callserver (Golang):
#   cp .env.example .env
# Sau khi sửa .env, hot-restart app (không phải hot-reload) để áp dụng.

# localhost đúng cho Windows/Chrome desktop. Nếu chạy Android emulator, đổi
# thành 10.0.2.2 (localhost của máy host nhìn từ emulator). Nếu chạy trên
# thiết bị thật, đổi thành IP LAN của máy chạy backend (vd. 192.168.1.x).
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080
