# Copy file này thành .env rồi chỉnh nếu cần: cp .env.example .env

PORT=8080

# Khớp với service postgres trong docker-compose.yml (port host 5434)
POSTGRES_DSN=postgres://callserver:callserver@localhost:5434/callserver?sslmode=disable

# Khớp với service redis trong docker-compose.yml (port host 6380)
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# Đổi thành chuỗi random dài khi deploy thật — đây chỉ là giá trị dev.
JWT_SECRET=dev-jwt-secret-change-me

# PHẢI trùng với static-auth-secret trong coturn/turnserver.conf
TURN_SECRET=change-me-dev-secret
TURN_REALM=call.local
TURN_URLS=turn:localhost:3478

INSTANCE_ID=instance-1

# Service account JSON tải từ Firebase Console (Project settings > Service
# accounts > Generate new private key) — để trống thì dùng LogDispatcher.
FIREBASE_CREDENTIALS_PATH=
